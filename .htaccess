# Apache SPA fallback. Vite copies this into dist/ on build.
# Direct hits and refreshes on client routes (e.g. /projects/aspen) must
# serve index.html; the router then takes over. Existing files are left alone.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # If a git checkout or leftover source ever sits in this web root, do not serve it.
  RewriteRule ^\.git - [F,L]
  RewriteRule ^\.env - [F,L]
  RewriteRule ^(src|scripts|node_modules)/ - [F,L]
  RewriteRule ^(package\.json|pnpm-lock\.yaml|tsconfig\.json)$ - [F,L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
