# Copy to .env.local to override.

# Where the contact form posts.
# Leave unset to post to /contact.php on this site. cPanel runs that script and emails
# info@greyedgegroup.com. Set this to post JSON to a CRM intake endpoint, serverless
# function, or a service like Formspree instead.
# VITE_FORM_ENDPOINT=https://example.com/api/contact
